{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niyamcart.local/schemas/agent-policy.schema.json",
  "title": "NiyamCart Agent Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "merchant_id", "default_decision", "limits", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "merchant_id": {"type": "string", "minLength": 1},
    "default_decision": {"enum": ["allow", "deny", "escalate"]},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "max_line_quantity", "max_cart_items", "escalate_above_paise", "cart_ttl_seconds"],
      "properties": {
        "currency": {"const": "INR"},
        "max_line_quantity": {"type": "integer", "minimum": 1},
        "max_cart_items": {"type": "integer", "minimum": 1},
        "escalate_above_paise": {"type": "integer", "minimum": 0},
        "cart_ttl_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "description", "condition"],
        "properties": {
          "id": {"type": "string", "pattern": "^POL-"},
          "decision": {"enum": ["allow", "deny", "escalate"]},
          "description": {"type": "string", "minLength": 1},
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "operator", "value"],
            "properties": {
              "field": {"type": "string"},
              "operator": {"enum": ["in", "not_in", "not_equal", "greater_than", "always"]},
              "value": {}
            }
          }
        }
      }
    }
  }
}
