APP_ENV=development
APP_NAME=BoundedCart
API_PREFIX=/v1
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+psycopg://boundedcart:boundedcart@localhost:5432/boundedcart
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-development-secret

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AGENT_MAX_STEPS=8
AGENT_MAX_CART_REVISIONS=2

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ORDER_READY_CONTENT_SID=
TWILIO_PAYMENT_CONFIRMED_CONTENT_SID=

