APP_ENV=development
APP_NAME=NiyamCart
API_PREFIX=/v1
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

DATABASE_URL=sqlite:///./niyamcart.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-development-secret

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AGENT_MAX_STEPS=8
AGENT_MAX_CART_REVISIONS=2
AGENT_MAX_COST_MICROUSD=3000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

WHATSAPP_HANDOFF_ENABLED=false
PUBLIC_APP_URL=http://localhost:3000
WHATSAPP_LINK_SECRET=replace-with-at-least-32-random-characters
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_REVIEW_CONTENT_SID=
TWILIO_CONFIRMATION_CONTENT_SID=
